generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Department {
  hr_admin
  project_engineer
  design_engineer
  purchase
  accounts
  owner_admin
  // Reviews other departments' completed work (see TaskReview) — same page access as
  // hr_admin (see isAdminEditor) plus its own /my-tasks review queue, minus /performance.
  operations_manager
}

enum PaymentStatus {
  pending
  partial
  received
}

enum GlassType {
  normal
  laminated
}

enum VisitUrgency {
  emergency
  hot
  cold
  site_not_ready
}

// current_phase on projects (includes "completed")
enum ProjectPhase {
  phase_1
  phase_2
  phase_3
  completed
}

enum OverallStatus {
  on_track
  delayed
  blocked
  completed
}

// phase on phase_steps (no "completed" phase — a step's own status tracks completion)
enum StepPhase {
  phase_1
  phase_2
  phase_3
}

enum StepStatus {
  not_started
  in_progress
  blocked
  completed
}

enum ItemType {
  section
  hardware
  gasket
}

enum DelayCategory {
  client_side
  in_house
}

enum BlockedReason {
  client_payment_hold
  client_hold
  site_not_ready
  section_damage
  powder_coating_damage
  section_and_powder_coating_damage
  hardware_damage
  glass_damage
  requirement_wrong_section
  requirement_wrong_hardware
  requirement_wrong_gasket
  requirement_wrong_glass
  vendor_issue_section
  vendor_issue_hardware
  vendor_issue_gasket
  vendor_issue_glass
  fabrication_damage_section
  fabrication_damage_hardware
  fabrication_damage_glass
  transportation_damage_section
  transportation_damage_hardware
  transportation_damage_glass
  wrong_tight_measurement
  other
}

// ---------------------------------------------------------------------------
// Models
//
// All DateTime fields use @db.Timestamptz(3) explicitly. Without it, Prisma's
// PostgreSQL default is `timestamp` (no timezone), which writes using the
// server's local offset but reads back assuming UTC — silently shifting every
// timestamp by the local UTC offset on every round trip. Timestamptz stores
// true instants and removes that asymmetry.
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  department   Department
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  statusChanges        StepStatusLog[]      @relation("StatusChangedBy")
  qcCheckedItems       ProcurementItem[]    @relation("QcCheckedBy")
  qcCheckedGlassOrders GlassPurchaseOrder[] @relation("GlassQcCheckedBy")
  notifications        Notification[]

  @@index([department])
  @@map("users")
}

model Project {
  id   String @id @default(cuid())
  name String

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  finalCost      Decimal       @map("final_cost") @db.Decimal(12, 2)
  amountReceived Decimal       @default(0) @map("amount_received") @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(pending) @map("payment_status")

  glassType GlassType @map("glass_type")

  roughDesignCompletedAt DateTime?     @map("rough_design_completed_at") @db.Timestamptz(3)
  visitUrgency           VisitUrgency? @map("visit_urgency")

  currentPhase  ProjectPhase  @default(phase_1) @map("current_phase")
  overallStatus OverallStatus @default(on_track) @map("overall_status")

  plannedStartDate DateTime? @map("planned_start_date") @db.Timestamptz(3)
  plannedEndDate   DateTime? @map("planned_end_date") @db.Timestamptz(3)
  actualStartDate  DateTime? @map("actual_start_date") @db.Timestamptz(3)
  actualEndDate    DateTime? @map("actual_end_date") @db.Timestamptz(3)

  notes String? @db.Text

  // The "Phase 1/3 customer review" cards (Step timeline, HR & Admin only, see PhaseReviewCard)
  // — a freeform record of the client's own feedback, entirely separate from the phase_step/
  // dependency graph on purpose: no gate, blocks nothing, and reverting or editing any real step
  // never touches them. Planned end date isn't stored here at all — each card just displays its
  // matching step's own plannedEndDate read-only (2A for phase 1, 3E for phase 3, see
  // ProjectDetailPage), so it always tracks that live instead of needing to be kept in sync.
  phase1ReviewActualEndDate DateTime? @map("phase1_review_actual_end_date") @db.Timestamptz(3)
  phase1ReviewNote          String?   @map("phase1_review_note") @db.Text
  phase3ReviewActualEndDate DateTime? @map("phase3_review_actual_end_date") @db.Timestamptz(3)
  phase3ReviewNote          String?   @map("phase3_review_note") @db.Text

  // Phase 3's own last card (see WebsiteReviewCard.tsx) — did HR ask the client to leave a
  // website review once installation's final QC (3E) actually wrapped up? A plain yes/no,
  // deliberately its own boolean rather than folding into a qcPassed-style field — those feed
  // getEffectiveOverallStatus's "qc_failed" project status elsewhere, and a plain "no" answer
  // here must never be mistaken for a failed QC check. Null until answered; surfaced as an
  // HR & Admin task (see buildCustomerReviewTasks in unified-tasks.ts) whose planned date is
  // 3E's own actual end date + 1 day — there's nothing to ask about until then.
  websiteReviewAsked Boolean?  @map("website_review_asked")
  websiteReviewedAt  DateTime? @map("website_reviewed_at") @db.Timestamptz(3)
  websiteReviewNote  String?   @map("website_review_note") @db.Text

  // Soft delete: set when a project is removed from the app. The row and everything hanging
  // off it are kept — deleting is a UI action, not a data one — but every read path filters
  // these out, so a deleted project is invisible across the whole front end. See lib/prisma.ts,
  // which enforces that centrally rather than leaving it to each query to remember.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  phaseSteps         PhaseStep[]
  procurementItems   ProcurementItem[]
  glassPurchaseOrder GlassPurchaseOrder?
  paymentSchedule    PaymentSchedule?
  notifications      Notification[]
  workBlocks         WorkBlock[]

  @@index([currentPhase])
  @@index([overallStatus])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@index([clientId])
  @@map("projects")
}

// A client can have several projects and/or services over time — pulled out into its own
// table (rather than each Project/Service carrying its own name/phone/address, as they used
// to) so a repeat client is picked from a search dropdown instead of retyping their details,
// slightly differently, on every new project or service. Not soft-deletable like Project/
// Service: a client with no projects or services attached has no history worth preserving, so
// it's just removed outright (see DELETE /api/clients/[id]) — the FK from Project/Service is
// left at its default RESTRICT, so the database itself refuses to delete one still in use.
model Client {
  id      String @id @default(cuid())
  name    String
  phone   String
  address String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects Project[]
  services Service[]

  @@index([name])
  @@map("clients")
}

// The vendor/crew side of a job — installation labor, transport, powder coating, etc. — kept as
// its own list-and-add console, same shape as Client. First linked into Project via 3C1's own
// Planned-dates Save CTA (see MANUAL_CONTRACTOR_STEP_CODES in TaskCard.tsx); onDelete: SetNull
// on that relation rather than the default Restrict, so removing a contractor from the console
// never blocks on — or 500s over, per Client's own lesson about Postgres SQLSTATE 23001 — a step
// that once pointed at it. It just clears back to unassigned.
model Contractor {
  id      String @id @default(cuid())
  name    String
  phone   String
  address String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  phaseSteps PhaseStep[]

  @@index([name])
  @@map("contractors")
}

model PhaseStep {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phase    StepPhase
  stepCode String    @map("step_code")
  stepName String    @map("step_name")

  owningDepartment    Department  @map("owning_department")
  secondaryDepartment Department? @map("secondary_department")

  plannedDurationDays Int?     @map("planned_duration_days")
  dependsOn           String[] @map("depends_on")

  status StepStatus @default(not_started)

  plannedStartDate DateTime? @map("planned_start_date") @db.Timestamptz(3)
  plannedEndDate   DateTime? @map("planned_end_date") @db.Timestamptz(3)
  actualStartDate  DateTime? @map("actual_start_date") @db.Timestamptz(3)
  actualEndDate    DateTime? @map("actual_end_date") @db.Timestamptz(3)

  // 3C2 ("Installation") and 2D2 ("Final tight measurement at site") only — see
  // COMPUTED_PLANNED_DATE_OVERRIDE_STEP_CODES. Each has its own computed default (the
  // Installation planned window for 3C2, Section's Order-confirmed date + 18 working days for
  // 2D2 — see computeInstallationPlannedWindow/computeExpectedFinalMeasurementDate, both wired
  // into rescheduleProjectDates) that's only a rough default — planned_start_date/
  // planned_end_date above track it automatically right up until an admin sets these, at which
  // point the override wins outright and reschedule stops touching that field, the same
  // "override always wins" rule every procurement/glass-PO stage's own xxx_planned_override
  // column already follows (see POST /api/phase-steps/[id]/dates). 2D2 only ever uses
  // plannedEndDateOverride (a single-day site visit has no meaningful start of its own — see
  // MANUAL_PLANNED_END_ONLY_STEP_CODES). Null clears an override and goes back to tracking the
  // computed default. Null for every other step.
  plannedStartDateOverride DateTime? @map("planned_start_date_override") @db.Timestamptz(3)
  plannedEndDateOverride   DateTime? @map("planned_end_date_override") @db.Timestamptz(3)

  // 3C1/3E only (see MANUAL_PLANNED_DATE_STEP_CODES) — normally only an admin can fill in this
  // step's own manual Planned start/end (see /api/phase-steps/[id]/dates). An admin can delegate
  // that to one department instead by setting this field (see
  // /api/phase-steps/[id]/planned-date-permission) — once set, that department gets a "Set
  // planned dates" task of its own in /my-tasks (see MANUAL_PLANNED_DATE_STEP_CODES in
  // unified-tasks.ts), reachable via the separate /api/phase-steps/[id]/planned-dates route
  // rather than the admin-only one. Left set after use (not cleared once the dates are filled
  // in) purely as a record of who was delegated — the task itself disappears on its own once
  // the dates are locked in, same as contractorId below. 3C2 doesn't use this — its own override
  // above is always admin-only, there's nothing to delegate.
  plannedDateEditDepartment Department? @map("planned_date_edit_department")

  // 3C1 only today (see MANUAL_CONTRACTOR_STEP_CODES in TaskCard.tsx) — which crew is doing the
  // aluminum framework, chosen alongside that step's own manual Planned start/end and saved by
  // the same CTA. onDelete: SetNull, not the schema default Restrict: a contractor removed from
  // the /contractors console should just leave this unassigned, never block the delete.
  contractorId String?     @map("contractor_id")
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  blockedReason BlockedReason? @map("blocked_reason")
  blockedNote   String?        @map("blocked_note") @db.Text
  notes         String?        @db.Text

  // Set only when this step (currently just 1B) completes after its planned finish — records
  // whether the slip was the client's fault or an internal one. Read by reschedule.ts: an
  // in_house delay freezes the next step's planned dates at what was first computed instead of
  // letting them shift out with the late actual end, the way a client_side delay still does.
  delayCategory DelayCategory? @map("delay_category")

  // Idempotency guard for the overdue-notification cron (see notify-overdue.ts): set the
  // moment notifications go out for this step being overdue, so a daily run doesn't re-notify
  // the same step every day. Cleared back to null wherever planned_end_date changes, so a step
  // that slips further (or is corrected) is eligible to be (re-)notified.
  notifiedOverdueAt DateTime? @map("notified_overdue_at") @db.Timestamptz(3)

  // 3E only — the final on-site QC check. null = not yet checked, true = passed (the *only*
  // way this step's own status can reach "completed" — see updateStepStatus), false = failed.
  // Same 3-state convention as ProcurementItem.qcPassed, but adapted for a step that gates the
  // whole project rather than a downstream derived step: a failure here leaves status sitting
  // at in_progress instead of completing anyway, so recomputeProjectPhase never calls the
  // project done off a failed check. Re-submitting Pass/Fail (the same buttons TaskCard already
  // shows) is how a recheck happens — no separate mechanism needed.
  qcCheckedAt DateTime? @map("qc_checked_at") @db.Timestamptz(3)
  qcPassed    Boolean?  @map("qc_passed")

  // Only meaningful once qcPassed is false — the corrective plan for redoing 3E. Same "note
  // mandatory unconditionally" convention as ProcurementItem/GlassPurchaseOrder's own action
  // plan; planned 2 days after qcCheckedAt (see computeExpectedActionPlanDate, reused as-is).
  actionPlanAt   DateTime? @map("action_plan_at") @db.Timestamptz(3)
  actionPlanNote String?   @map("action_plan_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  statusLogs        StepStatusLog[]
  blockedWorkBlocks WorkBlock[]
  notifications     Notification[]
  actionItems       PhaseStepActionItem[]

  @@index([projectId])
  @@index([stepCode])
  @@index([owningDepartment])
  @@index([status])
  @@map("phase_steps")
}

// A user-defined follow-up task under 3E's action plan — mirrors ProcurementActionItem/
// GlassActionItem exactly, just scoped to a PhaseStep (only ever 3E, in practice) instead. Only
// ever created once 3E has actually failed QC and its action plan is marked (see the
// /action-items route) — deleted alongside the rest of the step's lifecycle on a revert.
model PhaseStepActionItem {
  id          String    @id @default(cuid())
  phaseStepId String    @map("phase_step_id")
  phaseStep   PhaseStep @relation(fields: [phaseStepId], references: [id], onDelete: Cascade)

  taskLabel   String     @map("task_label")
  // Same "picked at creation, independent of the fixed stage's own owner" idea as
  // ProcurementActionItem.department — see its comment for why this is defaulted.
  department  Department @default(project_engineer)
  // Same "opt into Pass/Fail at creation" idea as ProcurementActionItem.isPassFail.
  isPassFail  Boolean    @default(false) @map("is_pass_fail")
  plannedDate DateTime   @map("planned_date") @db.Timestamptz(3)
  actualDate  DateTime?  @map("actual_date") @db.Timestamptz(3)
  // Only meaningful when isPassFail is true — see ProcurementActionItem.qcPassed.
  qcPassed    Boolean?   @map("qc_passed")
  note        String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([phaseStepId])
  @@map("phase_step_action_items")
}

model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Plain string rather than a Prisma enum — future notification kinds shouldn't need a migration.
  type    String @default("step_overdue")
  message String @db.Text

  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseStepId String?    @map("phase_step_id")
  phaseStep   PhaseStep? @relation(fields: [phaseStepId], references: [id], onDelete: Cascade)

  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  // Idempotency key for the kinds a repeating job produces (see notifyDepartments in
  // notifications.ts), so a daily cron doesn't re-tell everyone the same thing: unique per
  // user, which lets createMany(skipDuplicates) drop the repeat without a read-then-write.
  // Keys embed the planned date they were raised against, so a date that moves is a new key
  // and gets notified again — the same "re-notify only when it actually slips" rule
  // phase_steps.notified_overdue_at gives the overdue-step cron. Null for event-driven kinds
  // (a block, a QC failure): those fire once per action and need no guard, and Postgres treats
  // every null here as distinct, so they never collide with each other.
  dedupeKey String? @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

model ProcurementItem {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  itemType ItemType @map("item_type")

  // Overrides the project-wide planned-date anchor (1D's actual end + 1 day) for this item
  // alone — set when restarting an item after a QC failure, per the client's own new timeline
  // for it. Every planned date on this item (requirement/quote/payment/order/arrival/QC) is
  // computed from this instead of the shared anchor once it's set. Null means "use the
  // project default", same as every item behaves today.
  planAnchorOverride DateTime? @map("plan_anchor_override") @db.Timestamptz(3)

  requirementCreatedAt       DateTime? @map("requirement_created_at") @db.Timestamptz(3)
  requirementNote            String?   @map("requirement_note") @db.Text
  // Manual override for this stage's Planned date — null means "keep computing it from the
  // anchor/offset formula as usual". Setting one re-anchors every stage after it in the same
  // item's chain (see computeProcurementPlannedDates), the same "shift together" principle
  // planAnchorOverride already applies at the whole-item level.
  requirementPlannedOverride DateTime? @map("requirement_planned_override") @db.Timestamptz(3)
  quoteCreatedAt             DateTime? @map("quote_created_at") @db.Timestamptz(3)
  quoteNote                  String?   @map("quote_note") @db.Text
  quotePlannedOverride       DateTime? @map("quote_planned_override") @db.Timestamptz(3)
  orderConfirmedAt           DateTime? @map("order_confirmed_at") @db.Timestamptz(3)
  orderNote                  String?   @map("order_note") @db.Text
  orderPlannedOverride       DateTime? @map("order_planned_override") @db.Timestamptz(3)

  // Section only — hardware/gasket never populate these two. Planned dates chain off the
  // previous stage's own ground-truth date (actual once known, else planned) rather than the
  // shared anchor — see computeSectionChainDates in procurement.ts. Each has its own manual
  // override too, same "shift every later stage in the chain" principle as every other stage.
  materialDespatchAt                     DateTime? @map("material_despatch_at") @db.Timestamptz(3)
  materialDespatchNote                   String?   @map("material_despatch_note") @db.Text
  materialDespatchPlannedOverride        DateTime? @map("material_despatch_planned_override") @db.Timestamptz(3)
  arrivedForPowderCoatingAt              DateTime? @map("arrived_for_powder_coating_at") @db.Timestamptz(3)
  arrivedForPowderCoatingNote            String?   @map("arrived_for_powder_coating_note") @db.Text
  arrivedForPowderCoatingPlannedOverride DateTime? @map("arrived_for_powder_coating_planned_override") @db.Timestamptz(3)

  paymentSettledAt       DateTime? @map("payment_settled_at") @db.Timestamptz(3)
  paymentNote            String?   @map("payment_note") @db.Text
  paymentDetails         String?   @map("payment_details") @db.Text
  paymentPlannedOverride DateTime? @map("payment_planned_override") @db.Timestamptz(3)
  expectedArrivalDate    DateTime? @map("expected_arrival_date") @db.Timestamptz(3)
  actualArrivalDate      DateTime? @map("actual_arrival_date") @db.Timestamptz(3)
  arrivalNote            String?   @map("arrival_note") @db.Text
  arrivalPlannedOverride DateTime? @map("arrival_planned_override") @db.Timestamptz(3)

  qcChecked         Boolean   @default(false) @map("qc_checked")
  qcCheckedAt       DateTime? @map("qc_checked_at") @db.Timestamptz(3)
  qcCheckedBy       String?   @map("qc_checked_by")
  qcCheckedByUser   User?     @relation("QcCheckedBy", fields: [qcCheckedBy], references: [id])
  // null = not yet checked, true = passed, false = failed. 2F only derives as complete once
  // every item is checked AND passed — a failed item blocks phase 3 until it's corrected.
  qcPassed          Boolean?  @map("qc_passed")
  qcNote            String?   @map("qc_note") @db.Text
  qcPlannedOverride DateTime? @map("qc_planned_override") @db.Timestamptz(3)

  // Only meaningful once qcPassed is false — the corrective plan for redoing this item.
  // Planned 2 days after qc_checked_at (see computeExpectedActionPlanDate); the note is
  // mandatory here unconditionally, unlike the other stages where it's only required when late.
  actionPlanAt   DateTime? @map("action_plan_at") @db.Timestamptz(3)
  actionPlanNote String?   @map("action_plan_note") @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actionItems ProcurementActionItem[]

  @@index([projectId])
  @@index([itemType])
  @@map("procurement_items")
}

// A user-defined follow-up task under an item's action plan (e.g. "Reorder from an alternate
// vendor") — open-ended, unlike every other procurement stage above, which is a fixed column
// pair. Only ever created once that item has actually failed QC and its action plan is marked
// (see the /action-items route) — deleted alongside the rest of the item's lifecycle on a QC
// restart or an upstream revert cascade, since a stale follow-up task from a since-cleared
// failure has nothing left to explain.
model ProcurementActionItem {
  id                String          @id @default(cuid())
  procurementItemId String          @map("procurement_item_id")
  procurementItem   ProcurementItem @relation(fields: [procurementItemId], references: [id], onDelete: Cascade)

  taskLabel   String     @map("task_label")
  // Which department this ad-hoc follow-up is assigned to — chosen at creation time (see the
  // "+ Add row" form in ProcurementTracker.tsx), independent of whichever department the
  // procurement item's fixed stages belong to. Defaulted rather than required at the column
  // level so existing rows (and direct-Prisma test fixtures) don't need a backfill; the API
  // route itself always requires an explicit choice on create.
  department  Department @default(purchase)
  // When true, this row gets the "qc" stage's Pass/Fail button pair instead of a single Mark
  // complete button — some follow-up tasks (e.g. "re-inspect on arrival") are themselves a
  // pass/fail check. Opted into at creation only (see the checkbox next to Department in
  // AddActionItemRow), same as department — not editable afterward.
  isPassFail  Boolean    @default(false) @map("is_pass_fail")
  plannedDate DateTime   @map("planned_date") @db.Timestamptz(3)
  actualDate  DateTime?  @map("actual_date") @db.Timestamptz(3)
  // Only meaningful when isPassFail is true — null until that outcome is recorded, same
  // "unset/passed/failed" meaning as ProcurementItem.qcPassed on the fixed qc stage.
  qcPassed    Boolean?   @map("qc_passed")
  note        String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([procurementItemId])
  @@map("procurement_action_items")
}

// The 6-stage tracker for 3A ("Glass PO: requirement, quote, payment") — deliberately separate
// from ProcurementItem/ItemType (section/hardware/gasket): those exist for Phase 2 the moment
// 1D completes and drive 2A/2D1/2F's derived status, none of which applies here. This is a
// single row per project, created once Phase 3 is seeded (2F completes — see
// seedNextPhaseIfNeeded). Unlike Phase 2's procurement, Phase 3 never carries a *computed*
// planned date (see rescheduleProjectDates's phase_3 exclusion) — every xPlannedDate column here
// is a plain, freeform field filled in by hand, not a forecast with a manual override on top the
// way ProcurementItem's xPlannedOverride columns are. 3A's own PhaseStep status is nonetheless
// derived from requirementCreatedAt/orderConfirmedAt — see syncGlassPOStepStatus.
model GlassPurchaseOrder {
  id        String  @id @default(cuid())
  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requirementCreatedAt   DateTime? @map("requirement_created_at") @db.Timestamptz(3)
  requirementNote        String?   @map("requirement_note") @db.Text
  requirementPlannedDate DateTime? @map("requirement_planned_date") @db.Timestamptz(3)

  quoteCreatedAt   DateTime? @map("quote_created_at") @db.Timestamptz(3)
  quoteNote        String?   @map("quote_note") @db.Text
  quotePlannedDate DateTime? @map("quote_planned_date") @db.Timestamptz(3)

  paymentSettledAt   DateTime? @map("payment_settled_at") @db.Timestamptz(3)
  paymentNote        String?   @map("payment_note") @db.Text
  paymentPlannedDate DateTime? @map("payment_planned_date") @db.Timestamptz(3)

  orderConfirmedAt DateTime? @map("order_confirmed_at") @db.Timestamptz(3)
  orderNote        String?   @map("order_note") @db.Text
  orderPlannedDate DateTime? @map("order_planned_date") @db.Timestamptz(3)

  actualArrivalDate  DateTime? @map("actual_arrival_date") @db.Timestamptz(3)
  arrivalNote        String?   @map("arrival_note") @db.Text
  arrivalPlannedDate DateTime? @map("arrival_planned_date") @db.Timestamptz(3)

  qcCheckedAt     DateTime? @map("qc_checked_at") @db.Timestamptz(3)
  qcCheckedBy     String?   @map("qc_checked_by")
  qcCheckedByUser User?     @relation("GlassQcCheckedBy", fields: [qcCheckedBy], references: [id])
  // null = not yet checked, true = passed, false = failed — same 3-state convention as
  // ProcurementItem.qcPassed. A failed check is what unlocks the action plan + custom rows below.
  qcPassed        Boolean?  @map("qc_passed")
  qcNote          String?   @map("qc_note") @db.Text
  qcPlannedDate   DateTime? @map("qc_planned_date") @db.Timestamptz(3)

  // Only meaningful once qcPassed is false — the corrective plan for redoing the glass PO.
  // Planned 2 days after qc_checked_at (see computeExpectedActionPlanDate, shared with
  // ProcurementItem's own action plan); the note is mandatory here unconditionally, unlike the
  // stages above where it's only required when late or correcting an already-done row.
  actionPlanAt   DateTime? @map("action_plan_at") @db.Timestamptz(3)
  actionPlanNote String?   @map("action_plan_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actionItems GlassActionItem[]

  @@map("glass_purchase_orders")
}

// A user-defined follow-up task under the glass PO's action plan — open-ended, unlike every
// other stage above, which is a fixed column pair. Only ever created once the glass PO has
// actually failed QC and its action plan is marked (see the /action-items route) — mirrors
// ProcurementActionItem exactly, just scoped to GlassPurchaseOrder instead of ProcurementItem.
model GlassActionItem {
  id                   String             @id @default(cuid())
  glassPurchaseOrderId String             @map("glass_purchase_order_id")
  glassPurchaseOrder   GlassPurchaseOrder @relation(fields: [glassPurchaseOrderId], references: [id], onDelete: Cascade)

  taskLabel   String     @map("task_label")
  // Same "picked at creation, independent of the fixed stages" idea as
  // ProcurementActionItem.department — see its comment for why this is defaulted.
  department  Department @default(purchase)
  // Same "opt into Pass/Fail at creation" idea as ProcurementActionItem.isPassFail.
  isPassFail  Boolean    @default(false) @map("is_pass_fail")
  plannedDate DateTime   @map("planned_date") @db.Timestamptz(3)
  actualDate  DateTime?  @map("actual_date") @db.Timestamptz(3)
  // Only meaningful when isPassFail is true — see ProcurementActionItem.qcPassed.
  qcPassed    Boolean?   @map("qc_passed")
  note        String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([glassPurchaseOrderId])
  @@map("glass_action_items")
}

// The "Payment schedule" modal on the project page — Token + 5 percentage-of-final-cost
// milestones (25/50/25/20/5), each just a received-or-not date. The row template itself
// (labels, percentages, order) is a fixed constant — see PAYMENT_MILESTONES in
// lib/payment-schedule.ts — not stored here, same "fixed stage list is code, per-project state
// is the row" split as GlassPurchaseOrder. One row per project, created lazily (upserted) the
// first milestone is ever marked received rather than seeded for every project up front.
model PaymentSchedule {
  id        String  @id @default(cuid())
  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tokenReceivedAt      DateTime? @map("token_received_at") @db.Timestamptz(3)
  milestone1ReceivedAt DateTime? @map("milestone_1_received_at") @db.Timestamptz(3) // 25%
  milestone2ReceivedAt DateTime? @map("milestone_2_received_at") @db.Timestamptz(3) // 50%
  milestone3ReceivedAt DateTime? @map("milestone_3_received_at") @db.Timestamptz(3) // 25%
  milestone4ReceivedAt DateTime? @map("milestone_4_received_at") @db.Timestamptz(3) // 20%
  milestone5ReceivedAt DateTime? @map("milestone_5_received_at") @db.Timestamptz(3) // 5%

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_schedules")
}

// A standalone work order — deliberately outside the Project/PhaseStep graph: no phases, no
// dependency chain, and no payment tracking (that's a Project-only concern — see
// PaymentSchedule). Shares only the client relation with Project; a service's entire lifecycle
// is its own flat list of work items (see ServiceItem), seeded with one "Action plan" row (see
// POST /api/services) and grown from there one row at a time.
model Service {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Set only by an explicit "mark as completed" action (see the completion dropdown in the
  // services list) — never inferred from item rows. Finishing every item still just reads
  // in_progress (see getServiceStatus in lib/service.ts); this is the one and only path to a
  // service reading as "completed", and clearing it back to null reopens it.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  // The post-completion "how did it go" follow-up — planned exactly 2 days after completedAt
  // (computed live in getServiceStatus, never stored, same "date-driven" convention as the
  // service's own delayed/review_not_completed statuses). No gate, blocks nothing on its own —
  // same spirit as Project's phase1Review/phase3Review pair — but left unfilled past its planned
  // date and the service's status flips to review_not_completed until reviewCompletedAt is set.
  // Reopening a completed service (completedAt cleared) clears both, so a later re-completion
  // starts a fresh review window instead of inheriting a stale one.
  reviewCompletedAt DateTime? @map("review_completed_at") @db.Timestamptz(3)
  reviewNote        String?   @map("review_note") @db.Text

  // Soft delete — same convention as Project (see lib/prisma.ts, which enforces the filter
  // centrally so every read path stays hidden without each query having to remember it).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items ServiceItem[]

  @@index([deletedAt])
  @@index([clientId])
  @@map("services")
}

// One open-ended work-item row on a service — there's no fixed stage list the way
// ProcurementItem has (requirement/quote/order/arrival/QC): a service starts with zero of
// these, and work begins the moment the first one is added. Same shape, and same "+ Add row"
// flow, as ProcurementActionItem's own custom follow-up rows (task, department, optional
// pass/fail, planned/actual date, note) — see ServiceTracker.tsx.
model ServiceItem {
  id        String  @id @default(cuid())
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  taskLabel   String     @map("task_label")
  department  Department @default(purchase)
  // When true, this row gets a Pass/Fail button pair instead of a single Mark complete button —
  // same opt-in-at-creation idea as ProcurementActionItem.isPassFail.
  isPassFail  Boolean    @default(false) @map("is_pass_fail")
  plannedDate DateTime   @map("planned_date") @db.Timestamptz(3)
  actualDate  DateTime?  @map("actual_date") @db.Timestamptz(3)
  // Only meaningful when isPassFail is true — null until that outcome is recorded, same
  // "unset/passed/failed" convention as ProcurementActionItem.qcPassed.
  qcPassed    Boolean?   @map("qc_passed")
  note        String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([serviceId])
  @@map("service_items")
}

// A group of extra work on a project, beyond its standard phase/procurement flow — e.g. "Extra
// balcony railing" — created one at a time from the project detail page (see
// AdditionalWorks.tsx). Deliberately just a label plus a flat list of rows (see WorkTask): no
// phases, no dependency chain, and nothing here gates, reschedules or changes the status of the
// project's own steps.
model WorkBlock {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label String

  // Set only on a block created from the "Confirm block" modal (see BlockedWorkModal) — the
  // phase step whose blocked situation these rows exist to resolve. Renders with a "Blocked work"
  // badge and feeds the "N/M tasks completed" line on /projects' Status column for that blocked
  // step; nothing else reads it. SetNull so deleting the step never takes the block with it.
  blockedPhaseStepId String?    @map("blocked_phase_step_id")
  blockedPhaseStep   PhaseStep? @relation(fields: [blockedPhaseStepId], references: [id], onDelete: SetNull)

  // Soft delete, same convention as Project/Service (see lib/prisma.ts, which enforces the
  // filter centrally): a mistaken delete keeps the block and all its rows in the database.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tasks WorkTask[]

  @@index([projectId])
  @@index([deletedAt])
  @@map("work_blocks")
}

// One open-ended work row inside a WorkBlock — same shape, and same "+ Add row" flow, as
// ServiceItem (task, department, optional pass/fail, planned/actual date, note): a block starts
// with zero of these and grows one row at a time. See ServiceTracker.tsx, whose row UI this shares.
model WorkTask {
  id          String    @id @default(cuid())
  workBlockId String    @map("work_block_id")
  workBlock   WorkBlock @relation(fields: [workBlockId], references: [id], onDelete: Cascade)

  taskLabel   String     @map("task_label")
  department  Department @default(purchase)
  // When true, this row gets a Pass/Fail button pair instead of a single Mark complete button —
  // opted into at creation only, same as ServiceItem.isPassFail.
  isPassFail  Boolean    @default(false) @map("is_pass_fail")
  plannedDate DateTime   @map("planned_date") @db.Timestamptz(3)
  actualDate  DateTime?  @map("actual_date") @db.Timestamptz(3)
  // Only meaningful when isPassFail is true — null until that outcome is recorded.
  qcPassed    Boolean?   @map("qc_passed")
  note        String?    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workBlockId])
  @@map("work_tasks")
}

model StepStatusLog {
  id          String    @id @default(cuid())
  phaseStepId String    @map("phase_step_id")
  phaseStep   PhaseStep @relation(fields: [phaseStepId], references: [id], onDelete: Cascade)

  changedByUserId String @map("changed_by_user_id")
  changedByUser   User   @relation("StatusChangedBy", fields: [changedByUserId], references: [id])

  oldStatus StepStatus @map("old_status")
  newStatus StepStatus @map("new_status")
  reason    String?    @db.Text

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([phaseStepId])
  @@map("step_status_log")
}

// The operation manager's review of one unit of already-completed work — a PhaseStep, a single
// procurement/glass-PO stage field, an action item, or a service item (see lib/task-reviews.ts).
// Deliberately not a row per source table: "pending review" is derived at read time (same
// "compute, don't persist" convention as isStepOverrun/delayed in overrun.ts) by finding a
// completed unit whose taskId has no row here yet, so nothing is written until someone actually
// reviews it. taskId reuses the exact composite id unified-tasks.ts already builds for that same
// unit (e.g. "phase_step:<id>", "procurement_stage:<id>:requirementCreatedAt",
// "service_item:<id>") — stable and already unique per completable unit, so no separate
// discriminator columns are needed.
model TaskReview {
  id         String   @id @default(cuid())
  taskId     String   @unique @map("task_id")
  reviewedAt DateTime @map("reviewed_at") @db.Timestamptz(3)
  reviewNote String?  @map("review_note") @db.Text

  // Snapshotted at review time (see resolveReviewContext in task-reviews.ts) rather than
  // re-derived later — the department-KPI report (department-kpi-report.ts) needs the
  // underlying unit's own completion date to score whether the review itself landed on time
  // (due REVIEW_DUE_DAYS after completedAt), and the display fields so its late-completions
  // drill-down can show something meaningful without a live join back to whichever of the 5
  // source tables taskId happens to point at.
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)
  taskLabel   String   @map("task_label")
  contextName String   @map("context_name")
  projectId   String   @map("project_id")

  // True for a review row skipToPhase writes for itself (backfilled history has nothing for the
  // operation manager to actually review) rather than one a human submitted through /my-tasks.
  // Keeps the row out of getReviewQueueTasks exactly like any other review, but
  // department-kpi-report.ts's getCompletedUnits excludes these from the "review" source
  // entirely — crediting or penalizing operations_manager for a review that never happened would
  // just replace "OM has too many reviews" with "OM's KPI is wrong," which isn't the ask.
  autoReviewed Boolean @default(false) @map("auto_reviewed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("task_reviews")
}
